# Practice Institute frontend build settings. VITE_* values are PUBLIC (compiled into the bundle):
# never put secrets here. Pass them as shell env vars to `npm run build:pages`
# (vite.config.ts reads process.env so the CSP can allow exactly this API origin).

# Student API base URL (your HTTPS tunnel hostname in production).
VITE_PI_API_BASE=https://api.example.invalid
# GitHub Pages repository subpath (build:pages sets /practice-institute/).
BASE_PATH=/practice-institute/
