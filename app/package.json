{
  "name": "practice-institute",
  "private": true,
  "version": "0.1.0",
  "description": "Practice Institute \u2014 friendly mock exams in English and Hindi: shared cohort/independent exams via a local API, plus an optional browser-only PDF practice mode.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "assets:tesseract": "node scripts/copy-tesseract-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-tesseract-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-tesseract-assets.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-tesseract-assets.mjs && tsc -b && BASE_PATH=/practice-institute/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:synthetic": "node scripts/make-synthetic-demo.mjs",
    "build:admin": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-tesseract-assets.mjs && tsc -b && vite build --config vite.admin.config.ts && node scripts/finish-admin-build.mjs",
    "assets:ocr:download": "python3 scripts/download-ocr-assets.py",
    "benchmark:ocr": "node scripts/benchmark-ocr.mjs",
    "qa:real-ocr": "vitest run --config qa.real-ocr.config.ts",
    "check:student-build": "node scripts/check-student-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
