# Practice Institute backend — copy to .env (never commit .env). Placeholders only; no secrets here.
# The admin password is NOT configured here: run `uv run pi-admin setup` (interactive).

# Where the SQLite database and uploaded source PDFs live (default: backend/data/)
PI_DATA_DIR=./data
# PI_DB_PATH=./data/practice-institute.sqlite3

# Bind address. Keep loopback; expose publicly only through an HTTPS tunnel (see ARCHITECTURE.md).
PI_HOST=127.0.0.1
PI_PORT=8787

# Exact browser origins allowed to call the STUDENT API (comma-separated, no trailing slash).
# Example for GitHub Pages: https://<your-github-user>.github.io
PI_ALLOWED_ORIGINS=http://127.0.0.1:4317

# true when served through HTTPS (tunnel). false only for http://127.0.0.1 development.
PI_COOKIE_SECURE=false
# Trust CF-Connecting-IP / X-Forwarded-For for rate limiting ONLY when behind your own tunnel.
PI_TRUST_PROXY_HEADERS=false

PI_MAX_BODY_BYTES=262144
PI_MAX_UPLOAD_BYTES=41943040
# Server allowance after deadline (ms), checked under the write lock. Cannot prove a request was in flight. Client timestamps are never trusted.
PI_SUBMIT_GRACE_MS=2000
PI_SESSION_TTL_S=28800
PI_JOIN_RATE_PER_MIN=20
PI_LOGIN_RATE_PER_MIN=8

# Reject originals above this page count before storing.
PI_MAX_SOURCE_PAGES=200
